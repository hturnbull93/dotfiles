# GitHub PR viewer - opens current branch PR in browser
prw() {
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD)
  if gh pr view "$branch" --web 2>/dev/null; then
    :
  else
    echo "No open PR found for branch '$branch'"
  fi
}

