# =============================================================================
# Claude Code / AI Configuration
# =============================================================================

export OPENROUTER_API_KEY="{{ .openrouterApiKey }}"

claude-open() {
  local model
  model=$(python3 -c "
import urllib.request, json, sys

with urllib.request.urlopen('https://openrouter.ai/api/v1/models') as r:
    data = json.loads(r.read())

def score(m):
    p = m.get('supported_parameters', [])
    return (
        ('tools' in p and 'tool_choice' in p),
        ('structured_outputs' in p),
        ('reasoning' in p or 'include_reasoning' in p),
        m.get('context_length', 0),
    )

free = [m for m in data['data'] if m['pricing']['prompt'] == '0' and m['pricing']['completion'] == '0']
free = [m for m in free if 'tools' in m.get('supported_parameters', [])]
free.sort(key=score, reverse=True)

for m in free:
    p = m.get('supported_parameters', [])
    flags = ''.join([
        'T' if 'tool_choice' in p else '-',
        'S' if 'structured_outputs' in p else '-',
        'R' if ('reasoning' in p or 'include_reasoning' in p) else '-',
    ])
    ctx = str(m['context_length'] // 1000) + 'k'
    print(f\"{flags}  {ctx:>7}  {m['id']}\")
" 2>/dev/null | fzf --prompt="Select model (TSR = tool_choice/structured/reasoning): " --height=40% --layout=reverse | awk '{print $NF}')

  [[ -z "$model" ]] && return 1

  ANTHROPIC_BASE_URL="https://openrouter.ai/api" \
  ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY" \
  ANTHROPIC_API_KEY="" \
  command claude --model "$model" "$@"
}

claude() {
  unset ANTHROPIC_BASE_URL
  unset ANTHROPIC_AUTH_TOKEN
  unset OPENROUTER_API_KEY
  if [[ " $* " != *" --model "* ]]; then
    command claude --model claude-sonnet-5 "$@"
  else
    command claude "$@"
  fi
}

kill-p() {
  local port pid
  for port in "$@"; do
    pid=$(lsof -ti tcp:"$port")
    if [[ -z "$pid" ]]; then
      echo "kill-p: nothing on port $port"
      continue
    fi
    echo "kill-p: SIGTERM pid $pid (port $port)"
    kill -TERM "$pid"
    local i=0
    while kill -0 "$pid" 2>/dev/null && (( i < 10 )); do
      sleep 0.5
      (( i++ ))
    done
    if kill -0 "$pid" 2>/dev/null; then
      echo "kill-p: SIGTERM failed, SIGKILL pid $pid (port $port)"
      kill -KILL "$pid"
    else
      echo "kill-p: pid $pid stopped"
    fi
  done
}

# =============================================================================
# Claude Status Poller
# =============================================================================
claude-status() {
  local interval=${1:-30}
  local api_url="https://api.anthropic.com/v1/models"
  local status_url="http://status.claude.com/api/v2/status.json"
  echo "claude-status: polling every ${interval}s — Ctrl+C to stop"
  while true; do
    local http_code indicator
    http_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 "$api_url" 2>/dev/null)
    indicator=$(curl -sL --max-time 10 "$status_url" 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['status']['description'])" 2>/dev/null)
    if [[ "$http_code" == "401" ]]; then
      echo "claude-status: API reachable, verifying model response..."
      local reply
      reply=$(claude -p 'what is the capital of france' 2>/dev/null)
      if [[ -n "$reply" ]]; then
{{- if eq .chezmoi.os "darwin" }}
        osascript -e 'display notification "Claude API is back up" with title "Claude Status" sound name "Glass"'
{{- else }}
        notify-send "Claude Status" "Claude API is back up" 2>/dev/null || true
{{- end }}
        echo "claude-status: API up — ${indicator:-unknown} ($(date +%H:%M:%S))"
        echo "claude-status: model says: $reply"
        return 0
      else
        echo "claude-status: API reachable but model not responding — ${indicator:-unknown} ($(date +%H:%M:%S))"
      fi
    else
      echo "claude-status: http=${http_code:-timeout} — ${indicator:-unknown} ($(date +%H:%M:%S))"
    fi
    sleep "$interval"
  done
}

# Monitor Railway logs for current branch (PR env) or production (main)
railway-pr-logs() {
  local branch project_id="830b1cb4-7ce3-419b-8d27-03d0d1465f78"
  branch=$(git branch --show-current)

  if [[ "$branch" == "main" ]]; then
    echo "On main → Railway env: production"
    railway logs --project "$project_id" --environment production --service web --latest
    return
  fi

  local pr_num
  pr_num=$(gh pr view --json number -q '.number' 2>/dev/null)
  if [[ -z "$pr_num" ]]; then
    echo "No open PR for branch: $branch" >&2
    return 1
  fi

  local env_name
  env_name=$(railway environment list --json 2>/dev/null \
    | jq -r ".environments[] | select(.meta.prNumber == $pr_num) | .name")
  if [[ -z "$env_name" ]]; then
    echo "No Railway environment found for PR #$pr_num (may still be provisioning)" >&2
    return 1
  fi

  echo "PR #$pr_num → Railway env: $env_name"
  railway logs --project "$project_id" --environment "$env_name" --service web --latest
}

