# SSH to Fedora machine with automatic Tailscale connection
function ssh-fedora() {
  if ! tailscale status &>/dev/null; then
    echo "Tailscale is down, bringing it up..."
    tailscale up 2>&1 | while IFS= read -r line; do
      echo "$line"
      if [[ "$line" =~ (https://login\.tailscale\.com/[^ ]+) ]]; then
        open "${match[1]}"
      fi
    done
    [[ ${pipestatus[1]} -eq 0 ]] && echo "Tailscale is up"
  fi
  ssh fedora
}

# Power flicker monitor management
_POWER_MONITOR_PID_FILE="/tmp/power-flicker-monitor.pid"

function power-flicker-start() {
  if [[ -f "$_POWER_MONITOR_PID_FILE" ]] && kill -0 "$(cat "$_POWER_MONITOR_PID_FILE")" 2>/dev/null; then
    echo "Already running (PID $(cat "$_POWER_MONITOR_PID_FILE"))"
    return 1
  fi
  bash ~/.power-flicker-monitor.sh &
  echo $! > "$_POWER_MONITOR_PID_FILE"
  echo "Power flicker monitor started (PID $!). Log: ~/.power-monitor.log"
}

function power-flicker-stop() {
  if [[ -f "$_POWER_MONITOR_PID_FILE" ]]; then
    kill "$(cat "$_POWER_MONITOR_PID_FILE")" 2>/dev/null && echo "Monitor stopped."
    rm -f "$_POWER_MONITOR_PID_FILE"
  else
    echo "Monitor is not running."
  fi
}

function power-flicker-status() {
  if [[ -f "$_POWER_MONITOR_PID_FILE" ]] && kill -0 "$(cat "$_POWER_MONITOR_PID_FILE")" 2>/dev/null; then
    echo "Running (PID $(cat "$_POWER_MONITOR_PID_FILE"))"
  else
    echo "Not running."
  fi
}

function power-flicker-log() {
  tail -f ~/.power-monitor.log
}

# Power metrics monitoring
function power-monitor() {
  sudo powermetrics --samplers cpu_power -i 1000 | while read line; do
    echo "$line" | grep -q "package power" && echo "$(date '+%H:%M:%S') | $(pmset -g batt | grep -E 'AC Power|Battery Power') | $line"
  done
}

# Open current directory in Terminal app
function term() { open -a Terminal "$PWD" }

